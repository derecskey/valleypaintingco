---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SwColorPalette from "../components/SwColorPalette.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  theme?: "blue" | "light" | "dark" | "white-snow" | "rain-cloud" | "silhouette" | "hidden-gem";
}

const {
  title,
  description = "Valley Painting Company — Northeast Ohio's trusted residential and commercial painters.",
  ogImage,
  theme,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <!--
      Anti-FOUC: apply the saved theme token before any CSS paints the page.
      Using is:inline so Astro does not bundle/defer this script.
    -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("vp-theme");
          if (t === "light" || t === "dark" || t === "white-snow" || t === "rain-cloud" || t === "silhouette" || t === "hidden-gem") {
            document.documentElement.setAttribute("data-theme", t);
          }
        } catch (_) {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!--
      Google Fonts — loaded with font-display: swap via &display=swap parameter.
      Preconnect hints allow parallel DNS + TLS negotiation before the
      stylesheet request fires, reducing font render-blocking time.
      • Playfair Display: elegant serif for headings (weights 400, 700; italic 400)
      • Lato: clean humanist sans-serif for body copy (weights 400, 700)
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    <SwColorPalette />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Skip-to-content link — visually hidden until focused */
  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 9999;
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-accent);
    color: var(--color-accent-text);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
    border-radius: var(--radius-md);
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform var(--transition-fast);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--color-accent-text);
    outline-offset: 2px;
  }

  /* Ensure body fills viewport height so footer stays at bottom */
  body {
    display: flex;
    flex-direction: column;
  }

  #main-content {
    flex: 1;
  }

  /* Remove default focus ring on main when skip link targets it */
  #main-content:focus {
    outline: none;
  }
</style>
