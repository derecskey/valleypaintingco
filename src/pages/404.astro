---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found | Valley Painting Company" description="Sorry, we couldn't find that page." theme="blue">
  <section class="not-found" style="text-align:center; padding: var(--space-6) 0;">
    <img src={(import.meta.env.BASE_URL || '') + 'images/Tipped-paint-bucket-fade.png'} alt="Tipped paint bucket" style="max-width:320px; width:100%; margin:0 auto 2rem; display:block; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.10));" loading="lazy" />
    <p style="font-size:1.25rem; margin-bottom:2rem; color:var(--color-text); text-align:center;">
      Sorry, the page you’re looking for doesn’t exist.
    </p>
  </section>
  <style>
    .not-found-link {
      display: inline-block;
      padding: 0.5em 1.25em;
      background: var(--color-primary);
      color: #fff;
      border-radius: var(--radius-md);
      text-decoration: none;
      font-weight: 600;
      font-size: 1.1rem;
      transition: background 0.2s;
      margin: 0 0.25em;
    }
    .not-found-link:hover,
    .not-found-link:focus {
      background: var(--color-accent);
      color: var(--color-accent-text);
    }
  </style>
</BaseLayout>
