---
import BaseLayout from "../layouts/BaseLayout.astro";
import testimonials from "../content/testimonials.json";
---

<BaseLayout
  title="Testimonials | Valley Painting Company"
  description="Hear from our satisfied customers across Northeast Ohio. Valley Painting Company has delivered quality residential and commercial painting for over 20 years."
>
  <section class="testimonials-page">
    <header class="page-header">
      <h1>What Our Customers Say</h1>
      <p class="intro">
        We're proud of the work we do and the relationships we build. Here's
        what customers throughout the Chagrin Valley and Northeast Ohio have to
        say about Valley Painting Company.
      </p>
    </header>

    <ul class="testimonials-list" role="list">
      {
        testimonials.map((t) => (
          <li class="testimonial-item">
            <blockquote>
              <p>{t.quote}</p>
              <footer>
                <cite>
                  <span aria-hidden="true">— </span>{t.attribution}
                  {t.detail ? <><span class="detail-sep" aria-hidden="true">·</span><span class="detail">{t.detail}</span></> : null}
                </cite>
              </footer>
            </blockquote>
          </li>
        ))
      }
    </ul>

    <aside class="review-platforms">
      <h2>Share Your Experience</h2>
      <p>Happy with our work? We'd love to hear from you on these platforms:</p>
      <ul class="platform-links" role="list">
        <li>
          <a
            href="https://maps.google.com/maps?q=Valley+Painting+Company+Chagrin+Falls+OH"
            rel="noopener noreferrer"
            target="_blank"
          >
            Leave a Google Review
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a
            href="https://www.facebook.com/ValleyPaintingCompany"
            rel="noopener noreferrer"
            target="_blank"
          >
            Leave a Facebook Review
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </aside>
  </section>
</BaseLayout>

<style>
  .testimonials-page {
    padding: var(--space-12) var(--space-8);
    max-width: 860px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .intro {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 65ch;
  }

  .testimonials-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-8);
  }

  .testimonial-item blockquote {
    border-left: 4px solid var(--color-accent);
    padding: var(--space-6) var(--space-8);
    background-color: var(--color-surface);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    margin: 0;
  }

  .testimonial-item blockquote p {
    font-size: var(--text-lg);
    font-style: italic;
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    max-width: none;
  }

  .testimonial-item blockquote footer {
    margin-top: var(--space-4);
  }

  .testimonial-item cite {
    font-style: normal;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
  }

  .detail-sep {
    color: var(--color-text-muted);
  }

  .detail {
    font-weight: var(--font-weight-normal);
  }

  .review-platforms {
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .review-platforms h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }

  .review-platforms p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }

  .platform-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .platform-links a {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-weight: var(--font-weight-bold);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .platform-links a:hover,
  .platform-links a:focus-visible {
    background-color: var(--color-surface-alt);
    border-color: var(--color-accent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (max-width: 600px) {
    .testimonials-page {
      padding: var(--space-8) var(--space-4);
    }

    .testimonial-item blockquote {
      padding: var(--space-4) var(--space-5);
    }
  }
</style>
