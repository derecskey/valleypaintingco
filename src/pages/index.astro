---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Valley Painting Company">
  <main style="padding: var(--space-12) var(--space-8); max-width: 800px; margin: 0 auto;">
    <h1>Valley Painting Company</h1>
    <p style="margin-top: var(--space-4); font-size: var(--text-lg);">
      Northeast Ohio's trusted residential and commercial painters.
    </p>
    <p style="margin-top: var(--space-6); color: var(--color-text-muted);">
      Serving the Chagrin Valley and surrounding communities with exceptional
      craftsmanship and attention to detail.
    </p>
  </main>
</BaseLayout>
