---
import fs from "node:fs";
import path from "node:path";
import Testimonial from "./Testimonial.astro";
import testimonials from "../content/testimonials.json";

interface HeroImage {
  src: string;
  alt: string;
}

/**
 * Generate human-readable alt text from a filename by removing the extension,
 * replacing hyphens with spaces, and capitalising each word.
 */
function altFromFilename(filename: string): string {
  return filename
    .replace(/\.[^.]+$/, "")
    .replace(/-/g, " ")
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

let heroImages: HeroImage[] = [];

try {
  const heroDir = path.join(process.cwd(), "public/images/hero");
  heroImages = fs
    .readdirSync(heroDir)
    .filter((f) => /\.(jpe?g|png|webp|avif)$/i.test(f))
    .sort() // deterministic order for consistent SSR output
    .map((f) => ({
      src: `${import.meta.env.BASE_URL}images/hero/${f}`,
      alt: altFromFilename(f),
    }));
} catch {
  // Directory missing or unreadable — hero renders without a background image.
}

const heroImagesJson = JSON.stringify(heroImages);
---

<section class="hero" aria-label="Welcome to Valley Painting Company">
  {
    heroImages.length > 0 && (
      <div
        class="hero-backdrop"
        aria-hidden="true"
        data-hero-images={heroImagesJson}
      >
        {/* Image is injected client-side so that only the randomly chosen one is fetched */}
      </div>
    )
  }

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content">
    <h1 class="hero-headline">Valley Painting Company</h1>
    <p class="hero-subheadline">
      Northeast Ohio&rsquo;s trusted residential and commercial painters &mdash;
      exceptional craftsmanship delivered across the Chagrin Valley and beyond.
    </p>
    <div class="hero-ctas">
      <a
        href="tel:+14405432840"
        class="hero-btn hero-btn-primary"
        aria-label="Call Valley Painting Company at 440-543-2840"
      >
        Call Now
      </a>
      <a href={`${import.meta.env.BASE_URL}estimate`} class="hero-btn hero-btn-secondary">
        Request an Estimate
      </a>
    </div>
  </div>

  <!-- Rotating testimonials strip -->
  <div class="hero-testimonials">
    <div class="hero-testimonial-track">
      {
        testimonials.map((t) => (
          <div class="hero-testimonial-slide" aria-hidden="true">
            <Testimonial
              quote={t.quote}
              attribution={t.attribution}
              detail={t.detail}
              variant="hero"
            />
          </div>
        ))
      }
    </div>
    <a href={`${import.meta.env.BASE_URL}testimonials`} class="hero-reviews-link">
      See More Reviews
    </a>
  </div>
</section>

{
  heroImages.length > 0 && (
    <script>
      (() => {
        const backdrop =
          document.querySelector<HTMLElement>(".hero-backdrop");
        if (!backdrop) return;

        let images: { src: string; alt: string }[] = [];
        try {
          images = JSON.parse(backdrop.dataset.heroImages ?? "[]");
        } catch {
          return;
        }
        if (images.length === 0) return;

        // Pick one random image and inject it — no carousel, no rotation
        const { src, alt } = images[Math.floor(Math.random() * images.length)];
        const img = document.createElement("img");
        img.src = src;
        img.alt = alt;
        img.className = "hero-image";
        img.loading = "eager";
        img.decoding = "sync";
        backdrop.appendChild(img);
      })();
    </script>
  )
}

<script>
  /* ---- Testimonial rotation ---- */
  (() => {
    const container = document.querySelector(".hero-testimonials");
    const slides = container
      ? [...container.querySelectorAll(".hero-testimonial-slide")]
      : [];
    if (slides.length === 0) return;

    let current = Math.floor(Math.random() * slides.length);
    let intervalId;
    let isHovered = false;
    let isFocused = false;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    function showSlide(idx) {
      slides.forEach((slide, i) => {
        const active = i === idx;
        slide.classList.toggle("is-active", active);
        slide.setAttribute("aria-hidden", active ? "false" : "true");
      });
      current = idx;
    }

    function advance() {
      showSlide((current + 1) % slides.length);
    }

    // (Re)start the interval only when no pause condition is active
    function startRotation() {
      clearInterval(intervalId);
      if (!isHovered && !isFocused && !reducedMotion.matches) {
        intervalId = setInterval(advance, 12000);
      }
    }

    // Show a random starting slide then begin rotation
    showSlide(current);
    startRotation();

    // Pause on hover — track state so focus events don't cause double-intervals
    container.addEventListener("mouseenter", () => {
      isHovered = true;
      clearInterval(intervalId);
    });
    container.addEventListener("mouseleave", () => {
      isHovered = false;
      startRotation();
    });

    // Pause while keyboard focus is inside the strip
    container.addEventListener("focusin", () => {
      isFocused = true;
      clearInterval(intervalId);
    });
    container.addEventListener("focusout", () => {
      isFocused = false;
      startRotation();
    });

    // Respect prefers-reduced-motion — re-evaluate whenever it changes
    reducedMotion.addEventListener("change", () => startRotation());
  })();
</script>

<style>
  /* ---- Hero container — 16:9 horizontal banner, max 768px tall ---- */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    width: 100%;
    max-height: 768px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    /* Fallback background when no images are present */
    background-color: var(--color-blue-800);
  }

  /* ---- Background image ---- */
  .hero-backdrop {
    position: absolute;
    inset: 0;
  }

  /*
   * .hero-image is injected at runtime via JavaScript, so it won't carry
   * Astro's scoped data attribute. :global() ensures the styles apply.
   */
  :global(.hero-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* ---- Gradient overlay — ensures legible text over any image ---- */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(0 27 52 / 0.55) 0%,
      rgb(0 27 52 / 0.65) 100%
    );
  }

  /* ---- Foreground content ---- */
  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: var(--space-8) var(--space-6) var(--space-4);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
  }

  .hero-headline {
    font-size: clamp(var(--text-xl), 5vw, var(--text-4xl));
    color: var(--color-white);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.4);
  }

  .hero-subheadline {
    margin: var(--space-3) auto 0;
    max-width: 52ch;
    font-size: clamp(var(--text-sm), 2vw, var(--text-base));
    color: var(--color-blue-50);
    line-height: var(--leading-relaxed);
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.5);
  }

  /* ---- CTAs ---- */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    border-radius: var(--radius-md);
    white-space: nowrap;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
    cursor: pointer;
  }

  .hero-btn:hover,
  .hero-btn:focus-visible {
    opacity: 0.92;
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .hero-btn:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }

  .hero-btn-primary {
    background-color: var(--color-hero-cta-primary-bg);
    color: var(--color-hero-cta-primary-text);
    border: 2px solid var(--color-hero-cta-primary-border);
  }

  .hero-btn-secondary {
    background-color: transparent;
    color: var(--color-white);
    border: 2px solid rgb(255 255 255 / 0.8);
  }

  .hero-btn-secondary:hover,
  .hero-btn-secondary:focus-visible {
    background-color: rgb(255 255 255 / 0.1);
  }

  /* ---- Testimonials strip ---- */
  .hero-testimonials {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    text-align: center;
    /* Layered transparency — partially occludes the image behind */
    background: rgb(0 27 52 / 0.6);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hero-testimonial-track {
    width: 100%;
    /* Stack all slides in the same grid cell; height is set by tallest slide */
    display: grid;
    min-height: 4.5rem;
  }

  .hero-testimonial-slide {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }

  .hero-testimonial-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-reviews-link {
    color: var(--color-blue-50);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .hero-reviews-link:hover,
  .hero-reviews-link:focus-visible {
    color: var(--color-white);
  }

  .hero-reviews-link:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* ---- Responsive adjustments ---- */
  @media (max-width: 640px) {
    .hero-content {
      padding: var(--space-4) var(--space-4);
    }

    .hero-ctas {
      flex-direction: column;
      align-items: center;
    }

    .hero-btn {
      width: 100%;
      max-width: 240px;
    }

    .hero-testimonials {
      padding: var(--space-3) var(--space-4);
    }

    .hero-testimonial-track {
      min-height: 5rem;
    }
  }
</style>
