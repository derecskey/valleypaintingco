---
import fs from "node:fs";
import path from "node:path";

interface HeroImage {
  src: string;
  alt: string;
}

/**
 * Generate human-readable alt text from a filename by removing the extension,
 * replacing hyphens with spaces, and capitalising each word.
 */
function altFromFilename(filename: string): string {
  return filename
    .replace(/\.[^.]+$/, "")
    .replace(/-/g, " ")
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

let heroImages: HeroImage[] = [];

try {
  const heroDir = path.join(process.cwd(), "public/images/hero");
  heroImages = fs
    .readdirSync(heroDir)
    .filter((f) => /\.(jpe?g|png|webp|avif)$/i.test(f))
    .sort() // deterministic order for consistent SSR output
    .map((f) => ({
      src: `/images/hero/${f}`,
      alt: altFromFilename(f),
    }));
} catch {
  // Directory missing or unreadable — hero renders without a background image.
}

const primaryImage: HeroImage | null = heroImages[0] ?? null;
// Remaining images are loaded client-side to avoid fetching every slide on page load
const remainingImagesJson = JSON.stringify(heroImages.slice(1));
---

<section class="hero" aria-label="Welcome to Valley Painting Company">
  {
    primaryImage && (
      <div
        class="hero-backdrop"
        aria-hidden="true"
        data-remaining-images={remainingImagesJson}
      >
        {/* Only the first image is server-rendered — keeps initial page weight low */}
        <img
          src={primaryImage.src}
          alt={primaryImage.alt}
          class="hero-slide is-active"
          loading="eager"
          decoding="sync"
        />
      </div>
    )
  }

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-content">
    <h1 class="hero-headline">Valley Painting Company</h1>
    <p class="hero-subheadline">
      Northeast Ohio&rsquo;s trusted residential and commercial painters &mdash;
      exceptional craftsmanship delivered across the Chagrin Valley and beyond.
    </p>
    <div class="hero-ctas">
      <a
        href="tel:+14405432840"
        class="hero-btn hero-btn-primary"
        aria-label="Call Valley Painting Company at 440-543-2840"
      >
        Call Now
      </a>
      <a href="/estimate" class="hero-btn hero-btn-secondary">
        Request an Estimate
      </a>
    </div>
  </div>
</section>

{
  heroImages.length > 1 && (
    <script>
      (() => {
        const backdrop =
          document.querySelector<HTMLElement>(".hero-backdrop");
        if (!backdrop) return;

        // Parse the remaining images from the data attribute and create
        // img elements client-side so they are not fetched on initial load.
        let remaining: { src: string; alt: string }[] = [];
        try {
          remaining = JSON.parse(
            backdrop.dataset.remainingImages ?? "[]",
          );
        } catch {
          return;
        }
        if (remaining.length === 0) return;

        remaining.forEach(({ src, alt }) => {
          const img = document.createElement("img");
          img.src = src;
          img.alt = alt;
          img.className = "hero-slide";
          img.loading = "lazy";
          img.decoding = "async";
          backdrop.appendChild(img);
        });

        const slides = Array.from(
          backdrop.querySelectorAll<HTMLImageElement>(".hero-slide"),
        );
        const count = slides.length;
        let current = 0;

        // Helper: swap the active slide instantly (no fade transition)
        function activateInstant(nextIndex: number): void {
          if (nextIndex === current) return;
          slides.forEach((s) => (s.style.transitionDuration = "0s"));
          slides[current].classList.remove("is-active");
          slides[nextIndex].classList.add("is-active");
          // Force a reflow so the instant swap is painted before the
          // transition duration is restored
          slides[nextIndex].getBoundingClientRect();
          slides.forEach((s) => (s.style.transitionDuration = ""));
          current = nextIndex;
        }

        // Pick a random starting slide; wait for it to fully load before
        // swapping so the hero doesn't briefly show a blank/loading image.
        const startIndex = Math.floor(Math.random() * count);
        if (startIndex !== 0) {
          const target = slides[startIndex];
          if (target.complete && target.naturalWidth > 0) {
            activateInstant(startIndex);
          } else {
            // Elevate priority so the browser fetches it sooner
            try {
              (target as HTMLImageElement).loading = "eager";
            } catch {
              // read-only in some browsers — ignore
            }
            target.addEventListener(
              "load",
              () => activateInstant(startIndex),
              { once: true },
            );
          }
        }

        // Respect users who prefer reduced motion — keep the initial image
        // but skip the automatic rotation/fade.
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          return;
        }

        // Rotate through slides every 25 seconds with a soft fade
        setInterval(() => {
          const prev = current;
          current = (current + 1) % count;
          slides[prev].classList.remove("is-active");
          slides[current].classList.add("is-active");
        }, 25_000);
      })();
    </script>
  )
}

<style>
  /* ---- Hero container ---- */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    /* Fallback background when no images are present */
    background-color: var(--color-blue-800);
  }

  /* ---- Background image carousel ---- */
  .hero-backdrop {
    position: absolute;
    inset: 0;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 800ms ease;
  }

  .hero-slide.is-active {
    opacity: 1;
  }

  /* ---- Gradient overlay — ensures legible text over any image ---- */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(0 27 52 / 0.55) 0%,
      rgb(0 27 52 / 0.65) 100%
    );
  }

  /* ---- Foreground content ---- */
  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-20) var(--space-8);
    text-align: center;
  }

  .hero-headline {
    font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    color: var(--color-white);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.4);
  }

  .hero-subheadline {
    margin: var(--space-6) auto 0;
    max-width: 58ch;
    font-size: clamp(var(--text-base), 2.5vw, var(--text-xl));
    color: var(--color-blue-50);
    line-height: var(--leading-relaxed);
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.5);
  }

  /* ---- CTAs ---- */
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-10);
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4) var(--space-8);
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    border-radius: var(--radius-md);
    white-space: nowrap;
    transition:
      opacity var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
    cursor: pointer;
  }

  .hero-btn:hover,
  .hero-btn:focus-visible {
    opacity: 0.92;
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }

  .hero-btn:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 3px;
  }

  .hero-btn-primary {
    background-color: var(--color-gold-400);
    color: var(--color-neutral-900);
    border: 2px solid transparent;
  }

  .hero-btn-secondary {
    background-color: transparent;
    color: var(--color-white);
    border: 2px solid rgb(255 255 255 / 0.8);
  }

  .hero-btn-secondary:hover,
  .hero-btn-secondary:focus-visible {
    background-color: rgb(255 255 255 / 0.1);
  }

  /* ---- Responsive adjustments ---- */
  @media (max-width: 640px) {
    .hero-content {
      padding: var(--space-16) var(--space-6);
    }

    .hero-ctas {
      flex-direction: column;
      align-items: center;
    }

    .hero-btn {
      width: 100%;
      max-width: 320px;
    }
  }
</style>
