---
import { Image } from "astro:assets";
import logoSrc from "../assets/logos/vpc-logo-white.png";
import ThemePicker from "./ThemePicker.astro";

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
  { href: "/service-areas", label: "Service Areas" },
  { href: "/testimonials", label: "Testimonials" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Valley Painting Company — Home">
      <Image
        src={logoSrc}
        alt="Valley Painting Company"
        width={138}
        height={44}
        class="logo-img"
      />
    </a>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li>
          <a href="/estimate" class="nav-cta">Request an Estimate</a>
        </li>
      </ul>
    </nav>

    <div class="header-controls">
      <ThemePicker />
      <button
        class="nav-toggle"
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>
</header>

<script>
  (() => {
    const header = document.querySelector<HTMLElement>(".site-header");
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const nav = document.getElementById("primary-nav");

    if (!header || !toggle || !nav) {
      return;
    }

    // Progressive enhancement: mark header so CSS can hide nav and show toggle.
    // Without this class (no JS), the nav remains fully visible on all screen
    // sizes and the hamburger button stays hidden — ensuring a usable no-JS state.
    header.classList.add("js-enabled");

    function openNav() {
      toggle.setAttribute("aria-expanded", "true");
      nav.classList.add("is-open");
      // Move focus to the first nav link so keyboard users can navigate immediately
      nav.querySelector<HTMLAnchorElement>("a")?.focus();
    }

    function closeNav(returnFocus = false) {
      toggle.setAttribute("aria-expanded", "false");
      nav.classList.remove("is-open");
      if (returnFocus) {
        toggle.focus();
      }
    }

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      expanded ? closeNav() : openNav();
    });

    // Close nav when a link is clicked (on mobile, after navigating)
    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => closeNav());
    });

    // Close nav on Escape key press and return focus to toggle.
    // The key check runs first so the getAttribute call is only reached on Escape.
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        closeNav(true);
      }
    });
  })();
</script>

<style>
  .site-header {
    background-color: var(--color-header-bg);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-md);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
    gap: var(--space-4);
  }

  /* Logo */
  .logo {
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-img {
    display: block;
    height: 44px;
    width: auto;
  }

  .logo:hover .logo-img,
  .logo:focus-visible .logo-img {
    opacity: 0.85;
  }

  /* Controls area: theme picker + hamburger toggle */
  .header-controls {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-shrink: 0;
  }

  /* Hamburger toggle button */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-header-text);
  }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .hamburger-bar {
    display: block;
    width: 24px;
    height: 2px;
    background-color: currentColor;
    border-radius: var(--radius-full);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  /* Animate hamburger to X when open */
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Primary navigation */
  .primary-nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-list li {
    margin-top: 0;
  }

  .nav-list a {
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--color-header-link);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .nav-list a:hover,
  .nav-list a:focus-visible {
    background-color: var(--color-header-link-hover-bg);
    color: var(--color-header-link-hover);
    outline: none;
  }

  .nav-list a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* CTA button in nav */
  .nav-list .nav-cta {
    background-color: var(--color-accent);
    color: var(--color-accent-text);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-4);
    transition: opacity var(--transition-fast);
  }

  .nav-list .nav-cta:hover,
  .nav-list .nav-cta:focus-visible {
    background-color: var(--color-accent);
    color: var(--color-accent-text);
    opacity: 0.9;
  }

  /* Mobile styles */
  @media (max-width: 767px) {
    /* JS-enhanced: show hamburger button and collapse nav by default */
    .js-enabled .nav-toggle {
      display: flex;
    }

    .js-enabled .primary-nav {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--color-nav-bg);
      border-top: 1px solid var(--color-border);
      box-shadow: var(--shadow-lg);
      /* Hidden state — slide up 6px (subtle reveal distance) and fade out.
         visibility uses a 0s duration with a delay equal to the transition so it
         hides only after opacity/transform finish, avoiding a mid-fade a11y gap. */
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(-6px);
      transition:
        opacity var(--transition-base),
        visibility 0s linear var(--transition-base),
        transform var(--transition-base);
    }

    .js-enabled .primary-nav.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
      /* Remove the visibility delay so it becomes visible immediately on open */
      transition:
        opacity var(--transition-base),
        visibility 0s linear,
        transform var(--transition-base);
    }

    /* No-JS fallback: nav is always visible, stacked vertically */
    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--color-nav-bg);
      border-top: 1px solid var(--color-border);
      box-shadow: var(--shadow-lg);
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-3) var(--space-4);
    }

    .nav-list li {
      border-bottom: 1px solid var(--color-header-mobile-divider);
    }

    .nav-list li:last-child {
      border-bottom: none;
      padding: var(--space-3) 0;
    }

    .nav-list a {
      font-size: var(--text-base);
      padding: var(--space-3) var(--space-2);
    }

    .nav-cta {
      text-align: center;
    }
  }

  /* Respect reduced-motion preference: skip slide animation, keep fade */
  @media (prefers-reduced-motion: reduce) {
    .js-enabled .primary-nav {
      transform: none;
      transition: opacity var(--transition-base), visibility 0s linear var(--transition-base);
    }
    .js-enabled .primary-nav.is-open {
      transition: opacity var(--transition-base), visibility 0s linear;
    }
  }
</style>
