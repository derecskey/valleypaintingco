---
const navLinks = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/about", label: "About" },
  { href: "/service-areas", label: "Service Areas" },
  { href: "/testimonials", label: "Testimonials" },
];
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Valley Painting Company — Home">
      <span class="logo-name">Valley Painting Company</span>
    </a>

    <button
      class="nav-toggle"
      aria-controls="primary-nav"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
      <span class="hamburger-bar"></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li>
          <a href="/estimate" class="nav-cta">Request an Estimate</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  (() => {
    const header = document.querySelector<HTMLElement>(".site-header");
    const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
    const nav = document.getElementById("primary-nav");

    if (!header || !toggle || !nav) {
      return;
    }

    // Progressive enhancement: mark header so CSS can hide nav and show toggle.
    // Without this class (no JS), the nav remains fully visible on all screen
    // sizes and the hamburger button stays hidden — ensuring a usable no-JS state.
    header.classList.add("js-enabled");

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      nav.classList.toggle("is-open", !expanded);
    });

    // Close nav when a link is clicked (on mobile, after navigating)
    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", "false");
        nav.classList.remove("is-open");
      });
    });
  })();
</script>

<style>
  .site-header {
    background-color: var(--color-blue-800);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: var(--shadow-md);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
    gap: var(--space-4);
  }

  /* Logo */
  .logo {
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-white);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .logo:hover .logo-name,
  .logo:focus-visible .logo-name {
    color: var(--color-blue-100);
  }

  /* Hamburger toggle button */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--color-white);
  }

  .nav-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .hamburger-bar {
    display: block;
    width: 24px;
    height: 2px;
    background-color: currentColor;
    border-radius: var(--radius-full);
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }

  /* Animate hamburger to X when open */
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Primary navigation */
  .primary-nav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-list a {
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--color-white);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .nav-list a:hover,
  .nav-list a:focus-visible {
    background-color: rgb(255 255 255 / 0.12);
    color: var(--color-white);
    outline: none;
  }

  .nav-list a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* CTA button in nav */
  .nav-list .nav-cta {
    background-color: var(--color-accent);
    color: var(--color-accent-text);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-4);
    transition: opacity var(--transition-fast);
  }

  .nav-list .nav-cta:hover,
  .nav-list .nav-cta:focus-visible {
    background-color: var(--color-accent);
    color: var(--color-accent-text);
    opacity: 0.9;
  }

  /* Mobile styles */
  @media (max-width: 767px) {
    /* JS-enhanced: show hamburger button and collapse nav by default */
    .js-enabled .nav-toggle {
      display: flex;
    }

    .js-enabled .primary-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--color-blue-900);
      border-top: 1px solid var(--color-border);
      box-shadow: var(--shadow-lg);
    }

    .js-enabled .primary-nav.is-open {
      display: block;
    }

    /* No-JS fallback: nav is always visible, stacked vertically */
    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background-color: var(--color-blue-900);
      border-top: 1px solid var(--color-border);
      box-shadow: var(--shadow-lg);
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: var(--space-3) var(--space-4);
    }

    .nav-list li {
      border-bottom: 1px solid rgb(255 255 255 / 0.08);
    }

    .nav-list li:last-child {
      border-bottom: none;
      padding: var(--space-3) 0;
    }

    .nav-list a {
      font-size: var(--text-base);
      padding: var(--space-3) var(--space-2);
    }

    .nav-cta {
      text-align: center;
    }
  }
</style>
