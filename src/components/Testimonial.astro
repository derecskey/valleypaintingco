---
interface Props {
  quote: string;
  attribution: string;
  detail?: string;
  /**
   * Visual variant:
   *   "default" — standard listing style (testimonials page)
   *   "hero"    — white text on the semi-transparent hero strip
   */
  variant?: "default" | "hero";
}

const { quote, attribution, detail, variant = "default" } = Astro.props;
---

<blockquote class:list={["testimonial", `testimonial--${variant}`]}>
  <p class="testimonial-quote">{quote}</p>
  <footer class="testimonial-footer">
    <cite class="testimonial-cite">
      <span aria-hidden="true">— </span>{attribution}
      {
        detail ? (
          <>
            <span class="testimonial-detail-sep" aria-hidden="true">
              {" "}
              &middot;{" "}
            </span>
            <span class="testimonial-detail">{detail}</span>
          </>
        ) : null
      }
    </cite>
  </footer>
</blockquote>

<style>
  .testimonial {
    margin: 0;
  }

  /* ---- Default variant — used on the Testimonials listing page ---- */
  .testimonial--default {
    border-left: 4px solid var(--color-accent);
    padding: var(--space-6) var(--space-8);
    background-color: var(--color-surface);
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }

  .testimonial--default .testimonial-quote {
    font-size: var(--text-lg);
    font-style: italic;
    line-height: var(--leading-relaxed);
    color: var(--color-text);
    max-width: none;
  }

  .testimonial--default .testimonial-footer {
    margin-top: var(--space-4);
  }

  .testimonial--default .testimonial-cite {
    font-style: normal;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
  }

  .testimonial--default .testimonial-detail-sep {
    color: var(--color-text-muted);
  }

  .testimonial--default .testimonial-detail {
    font-weight: var(--font-weight-normal);
  }

  /* ---- Hero variant — white text over the semi-transparent hero strip ---- */
  .testimonial--hero .testimonial-quote {
    font-size: clamp(var(--text-xs), 1.5vw, var(--text-sm));
    font-style: italic;
    line-height: var(--leading-relaxed);
    color: var(--color-white);
    max-width: none;
    text-align: center;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.5);
    overflow: hidden;
  }

  .testimonial--hero .testimonial-footer {
    margin-top: var(--space-2);
  }

  .testimonial--hero .testimonial-cite {
    font-style: normal;
    font-weight: var(--font-weight-bold);
    color: var(--color-blue-100);
    font-size: var(--text-xs);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-1) var(--space-2);
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.5);
  }

  .testimonial--hero .testimonial-detail-sep {
    color: var(--color-blue-200);
  }

  .testimonial--hero .testimonial-detail {
    font-weight: var(--font-weight-normal);
    color: var(--color-blue-200);
  }

  /* ---- Responsive ---- */
  @media (max-width: 600px) {
    .testimonial--default {
      padding: var(--space-4) var(--space-5);
    }
  }
</style>
